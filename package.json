{
  "name": "ui-oracle",
  "version": "0.1.0",
  "private": true,
  "description": "Oracle UI monorepo — studio, vector, canvas",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev:studio": "bun --cwd apps/studio run dev",
    "dev:vector": "bun --cwd apps/vector run dev",
    "dev:canvas": "bun --cwd apps/canvas run dev",
    "dev:schedule": "bun --cwd apps/schedule run dev",
    "dev:feed": "bun --cwd apps/feed run dev",
    "build:studio": "bun --cwd apps/studio run build",
    "build:vector": "bun --cwd apps/vector run build",
    "build:canvas": "bun --cwd apps/canvas run build",
    "build:schedule": "bun --cwd apps/schedule run build",
    "build:feed": "bun --cwd apps/feed run build",
    "build:all": "bun run build:studio && bun run build:vector && bun run build:canvas && bun run build:schedule && bun run build:feed",
    "preview:studio": "bun --cwd apps/studio run preview",
    "preview:vector": "bun --cwd apps/vector run preview",
    "preview:canvas": "bun --cwd apps/canvas run preview",
    "preview:schedule": "bun --cwd apps/schedule run preview",
    "preview:feed": "bun --cwd apps/feed run preview",
    "deploy:canvas": "bun --cwd apps/canvas run deploy",
    "deploy:schedule": "bun --cwd apps/schedule run deploy",
    "deploy:feed": "bun --cwd apps/feed run deploy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Soul-Brews-Studio/ui-oracle.git"
  },
  "author": "Soul Brews Studio",
  "license": "MIT",
  "patchedDependencies": {
    "knowledge-map-3d@github:Bombbaza/Multi-Planet-System-Knowledge-Map-3D#4dfd12d": "patches/knowledge-map-3d@github+Bombbaza+Multi-Planet-System-Knowledge-Map-3D+4dfd12d.patch"
  }
}

{
  "name": "ui-oracle",
  "version": "26.4.20-alpha.14",
  "private": true,
  "description": "Oracle UI monorepo — studio, vector, canvas",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev:studio": "bun run --cwd apps/studio dev",
    "dev:vector": "bun run --cwd apps/vector dev",
    "dev:canvas": "bun run --cwd apps/canvas dev",
    "dev:schedule": "bun run --cwd apps/schedule dev",
    "dev:feed": "bun run --cwd apps/feed dev",
    "dev:forum": "bun run --cwd apps/forum dev",
    "build:studio": "bun run --cwd apps/studio build",
    "build:vector": "bun run --cwd apps/vector build",
    "build:canvas": "bun run --cwd apps/canvas build",
    "build:schedule": "bun run --cwd apps/schedule build",
    "build:feed": "bun run --cwd apps/feed build",
    "build:forum": "bun run --cwd apps/forum build",
    "build:all": "bun run build:studio && bun run build:vector && bun run build:canvas && bun run build:schedule && bun run build:feed && bun run build:forum",
    "test:studio": "bun run --cwd apps/studio test",
    "test:studio:unit": "bun run --cwd apps/studio test:unit",
    "test:studio:e2e": "bun run --cwd apps/studio test:e2e",
    "preview:studio": "bun run --cwd apps/studio preview",
    "preview:vector": "bun run --cwd apps/vector preview",
    "preview:canvas": "bun run --cwd apps/canvas preview",
    "preview:schedule": "bun run --cwd apps/schedule preview",
    "preview:feed": "bun run --cwd apps/feed preview",
    "preview:forum": "bun run --cwd apps/forum preview",
    "deploy:studio": "bun run --cwd apps/studio deploy",
    "deploy:schedule": "bun run --cwd apps/schedule deploy",
    "deploy:feed": "bun run --cwd apps/feed deploy",
    "deploy:vector": "bun run --cwd apps/vector deploy",
    "deploy:canvas": "bun run --cwd apps/canvas deploy",
    "deploy:forum": "bun run --cwd apps/forum deploy",
    "deploy:all": "bun run deploy:studio && bun run deploy:vector && bun run deploy:canvas && bun run deploy:schedule && bun run deploy:feed && bun run deploy:forum",
    "sync:menu:gist": "bun run scripts/sync-menu.ts --gist https://gist.github.com/nazt/741e431a81ff32afb509cade18408054",
    "sync:menu:api": "bun run scripts/sync-menu.ts --api http://localhost:47778/api/menu",
    "sync:menu:reset": "bun run scripts/sync-menu.ts --reset"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Soul-Brews-Studio/ui-oracle.git"
  },
  "author": "Soul Brews Studio",
  "license": "BUSL-1.1",
  "patchedDependencies": {
    "knowledge-map-3d@github:Bombbaza/Multi-Planet-System-Knowledge-Map-3D#4dfd12d": "patches/knowledge-map-3d@github+Bombbaza+Multi-Planet-System-Knowledge-Map-3D+4dfd12d.patch"
  }
}
